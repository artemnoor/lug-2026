# Copy to .env.production in the deployment secret manager. Do not commit the copy.

LUG_ENV=production
NODE_ENV=production
PUBLIC_BASE_URL=https://example.invalid

POSTGRES_PASSWORD=replace-with-secret
LUG_DATABASE_PROVIDER=postgres
LUG_DATABASE_URL=postgresql://lug:replace-with-secret@postgres:5432/lug
LUG_DATABASE_SSL_MODE=verify-full
LUG_DATABASE_SSL_ROOT_CERT=/run/secrets/postgres-ca.pem
LUG_DATABASE_POOL_MIN_SIZE=2
LUG_DATABASE_POOL_MAX_SIZE=10

REDIS_URL=redis://:replace-with-secret@redis:6379/0
REDIS_PASSWORD=replace-with-secret

LUG_ADMIN_EMAIL=admin@example.invalid
LUG_ADMIN_PASSWORD=replace-with-secret
LUG_OPERATIONS_TOKEN=replace-with-at-least-32-random-characters
LUG_EMAIL_VERIFICATION_SECRET=replace-with-at-least-32-random-characters
LUG_EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key

LUG_FILE_STORAGE_PROVIDER=s3
LUG_S3_BUCKET=private-bucket
LUG_S3_REGION=ru-central1
LUG_S3_ENDPOINT=
LUG_S3_ACCESS_KEY=replace-with-secret
LUG_S3_SECRET_KEY=replace-with-secret
LUG_S3_SERVER_SIDE_ENCRYPTION=AES256
LUG_S3_SIGNED_URL_TTL=300
LUG_UPLOAD_SCAN_COMMAND=tcp://clamav:3310
LUG_UPLOAD_SCAN_REQUIRED=true

LUG_EMAIL_MODE=smtp
LUG_SMTP_HOST=smtp.example.invalid
LUG_SMTP_PORT=587
LUG_SMTP_USER=
LUG_SMTP_PASSWORD=replace-with-secret
LUG_SMTP_FROM=noreply@example.invalid

LUG_TRUST_PROXY=true
LUG_TRUSTED_PROXY_IPS=127.0.0.1
LUG_ALLOWED_HOSTS=example.invalid
